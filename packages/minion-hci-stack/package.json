{
  "name": "@bwowsersource/minion-hci-stack",
  "version": "0.1.3",
  "description": "Native inference stack for the minion: node-llama-cpp, cactus-needle (Needle + Whistle) and omnivoice-tts, with per-platform binaries as optional dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    },
    "./protocol/*": {
      "types": "./dist/protocol/*.d.ts",
      "default": "./dist/protocol/*.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cactus-needle": "0.3.0",
    "node-llama-cpp": "^3.22.1"
  },
  "optionalDependencies": {
    "@bwowsersource/minion-hci-stack-darwin-arm64": "0.1.3",
    "@bwowsersource/minion-hci-stack-linux-arm64": "0.1.3",
    "@bwowsersource/minion-hci-stack-linux-x64": "0.1.3",
    "@bwowsersource/minion-hci-stack-win32-x64": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bwowsersource/minion-hci-stack.git"
  }
}
