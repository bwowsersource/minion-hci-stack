{
  "name": "minion-hci-stack-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/platform/*"
  ],
  "scripts": {
    "test": "bun test packages/minion-hci-stack",
    "demo": "bun packages/minion-hci-stack/demo/index.ts",
    "demo:scoring": "bun packages/minion-hci-stack/demo/scoring.ts",
    "typecheck": "tsc --noEmit -p packages/minion-hci-stack",
    "build": "bun scripts/stage-platform-packages.ts",
    "publish": "bash scripts/publish-platform.sh",
    "githooks:install": "git config core.hooksPath scripts/hooks"
  },
  "trustedDependencies": [
    "node-llama-cpp"
  ],
  "packageManager": "bun@1.4.2"
}
