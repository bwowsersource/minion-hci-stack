#!/usr/bin/env bash
# Bumps the patch version of the main package (and the optionalDependencies that
# must match it) and folds it into the commit being created, but only when that
# commit touches packages/minion-hci-stack/src or scripts/. Doing it here rather
# than in pre-push means the version is already in history when the push happens.
#
# Runs once per push-worthy batch: if an earlier unpushed commit already bumped
# the version, it differs from origin/base's and this hook skips.
#
# Disable with: SKIP_VERSION_BUMP=1
set -uo pipefail
cd "$(dirname "$0")/../.."

[ "${SKIP_VERSION_BUMP:-}" = "1" ] && echo "SKIP_VERSION_BUMP=1" && exit 0

PKG=packages/minion-hci-stack/package.json

# Don't fight a manual edit to the manifest staged in this same commit.
git diff --cached --quiet -- "$PKG" || exit 0
git diff --cached --quiet -- packages/minion-hci-stack/src scripts/ && exit 0

CURRENT_VERSION="$(node -e "console.log(require('./$PKG').version)" 2>/dev/null)"
[ -z "$CURRENT_VERSION" ] && exit 0

if git rev-parse --verify origin/base^{commit} >/dev/null 2>&1; then
	REMOTE_PKG_JSON="$(git show "origin/base:$PKG" 2>/dev/null || true)"
	if [ -n "$REMOTE_PKG_JSON" ]; then
		REMOTE_VERSION="$(REMOTE_PKG_JSON="$REMOTE_PKG_JSON" node -e "console.log(JSON.parse(process.env.REMOTE_PKG_JSON).version)" 2>/dev/null)"
		if [ -n "$REMOTE_VERSION" ] && [ "$REMOTE_VERSION" != "$CURRENT_VERSION" ]; then
			exit 0
		fi
	fi
fi

IFS='.' read -r MAJOR MINOR PATCH <<<"$CURRENT_VERSION"
NEW_VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"

NEW_VERSION="$NEW_VERSION" PKG="$PKG" node -e "
const fs = require('fs');
const pkg = JSON.parse(fs.readFileSync(process.env.PKG, 'utf8'));
pkg.version = process.env.NEW_VERSION;
for (const name of Object.keys(pkg.optionalDependencies ?? {})) pkg.optionalDependencies[name] = process.env.NEW_VERSION;
fs.writeFileSync(process.env.PKG, JSON.stringify(pkg, null, 2) + '\n');
"
git add "$PKG"
echo "[release] bumped version ${CURRENT_VERSION} -> ${NEW_VERSION} (folded into this commit)"
