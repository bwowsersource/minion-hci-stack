#!/usr/bin/env bash
# Runs when pushing the `base` branch. Delegates to scripts/publish-platform.sh
# to build this host's omnivoice-tts, stage its platform package and publish it
# (and the main package, if that version isn't published yet) to GitHub Packages.
# Best-effort: any failure there warns and lets the push continue.
#
# Disable for a single push with: SKIP_PUBLISH_HOOK=1 git push
set -uo pipefail

[ "${SKIP_PUBLISH_HOOK:-}" = "1" ] && echo "SKIP_PUBLISH_HOOK=1" && exit 0

pushing_base=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/base" ]; then
		pushing_base=1
	fi
done

[ "$pushing_base" = "1" ] || exit 0

exec bash "$(dirname "$0")/../publish-platform.sh"
